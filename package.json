{
  "name": "@local/dsh-task-notifications",
  "version": "0.1.10",
  "engines": {
    "node": ">=22.0.0",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.1"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "Codex-style desktop notifications for DeepSeek Harness: task completion, approval requests, questions and custom sounds.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepublishOnly": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run tests/codex-notifications.spec.ts",
    "coverage": "vitest run --coverage",
    "verify:profile": "node scripts/verify-disposable-profile.cjs",
    "watch": "tsdown --watch"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2 || ^0.2.1-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jimmy-Official/dsh-task-notifications.git"
  },
  "homepage": "https://github.com/Jimmy-Official/dsh-task-notifications#readme",
  "bugs": {
    "url": "https://github.com/Jimmy-Official/dsh-task-notifications/issues"
  }
}
